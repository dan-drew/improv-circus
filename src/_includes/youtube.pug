mixin youtube
  iframe.youtube(
    width="560"
    height="315"
    src="https://www.youtube.com/embed/videoseries?si=BelaR06MaRV6aIYU&amp;list=PLetf8209pR38" 
    title="Improv Circus"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  )
