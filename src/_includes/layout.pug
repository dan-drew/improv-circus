include social

html
  head
    // Google Analytics
    script(async src="https://www.googletagmanager.com/gtag/js?id=G-LDRBHCEFT0")
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-LDRBHCEFT0');

    title
      block title
        = site.title
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="last-modified", content=build.timestamp)
    meta(http-equiv='content-language' content='en-us')
    block description
      meta(name="description" content=site.description)
    meta(property="og:image" content=site.socialImage)
    meta(property="og:image:alt" content=site.title + ' logo')
    meta(property="og:image:width" content="1254")
    meta(property="og:image:height" content="1254")
    meta(property="og:url" content=site.url + page.url)
    meta(property="og:site_name" content=site.title)
    meta(name="twitter:image" content=site.socialImage)
    meta(name="twitter:image:alt" content=site.title + ' logo')
    block meta
      meta(property="og:type" content="website")
      meta(property="og:title" content=site.title)
      meta(property="og:description" content=site.description)
      meta(name="twitter:card" content="summary_large_image")
      meta(name="twitter:title" content=site.title)
      meta(name="twitter:description" content=site.description)
    link(rel="canonical" href=site.url + page.url)
    link(rel="stylesheet" href="/css/styles.css")
    link(rel="icon" href="/images/favicons/favicon.ico" sizes="any")
    link(rel="icon" type="image/png" sizes="16x16" href="/images/favicons/favicon-16x16.png")
    link(rel="icon" type="image/png" sizes="32x32" href="/images/favicons/favicon-32x32.png")
    link(rel="icon" type="image/png" sizes="192x192" href="/images/favicons/icon-192x192.png")
    link(rel="icon" type="image/png" sizes="512x512" href="/images/favicons/icon-512x512.png")
    link(rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png")
    script(src='/scripts/page.js')

  body
    header
      nav.container.nav-container
        a.logo(href="/")
          img(src="/images/improv-circus.png", alt=site.title)
          span= site.title
        ul.nav-links
          li: a(href="/#shows") Shows
          li: a(href="/#players") Players

        .social
          +social_list(site.social)

    div.container
      block content

    footer
      div!= `&copy; ${new Date().getFullYear()} ${site.title}`
